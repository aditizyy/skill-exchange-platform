# This project uses two separate env files, one per app:
#
#   backend/.env.example   -> copy to backend/.env
#   frontend/.env.example  -> copy to frontend/.env
#
# Quick setup:
#   cp backend/.env.example backend/.env
#   cp frontend/.env.example frontend/.env
#
# Then fill in the real values (Mongo URI, JWT secret, etc.) in each .env file.
# Never commit the real .env files — they're already covered by .gitignore.
